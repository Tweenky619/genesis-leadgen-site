{
  "name": "genesis-leadgen",
  "main": "src/worker.js",
  "workers_dev": true,
  "routes": [
    { "pattern": "hc.goldenbeemalaj.com", "custom_domain": true },
    { "pattern": "goldback.goldenbeemalaj.com", "custom_domain": true },
    { "pattern": "goldenbeemalaj.com/hc", "zone_name": "goldenbeemalaj.com" },
    { "pattern": "goldenbeemalaj.com/hc/*", "zone_name": "goldenbeemalaj.com" },
    { "pattern": "goldenbeemalaj.com/goldback", "zone_name": "goldenbeemalaj.com" },
    { "pattern": "goldenbeemalaj.com/goldback/*", "zone_name": "goldenbeemalaj.com" }
  ],
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "leadgen-usage", "database_id": "d3b99e31-f40b-4b25-b15c-d6329835d81a" },
    { "binding": "LEADS_DB", "database_name": "goldenbeemalaj-leads", "database_id": "207c4a9e-62cf-44b9-b7e8-97c8c864b37f" }
  ]
}
